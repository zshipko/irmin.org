opam-version: "2.0"
name: "irmin-website"
synopsis: "Public homepage of Irmin"
license: "ISC"
maintainer: "Craig Ferguson <me@craigfe.io>"
authors: "Craig Ferguson <me@craigfe.io>"
homepage: "https://github.com/tarides/irmin.org"
bug-reports: "https://github.com/tarides/irmin.org/issues"
depends: [
  "ocaml" {>= "4.06.0"}
  "dune" {>= "1.11.0"}
  "irmin" {with-test}
  "irmin-cli" {with-test}
  "digestif" {>= "1.0.0"}
  "mdx" {>= "1.8.1"}
  "lwt" {with-test}
]
build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name] {with-test}
]
dev-repo: "git+https://github.com/tarides/irmin.org.git"
pin-depends: [
  ["irmin.dev" "git+https://github.com/mirage/irmin#eio"]
  ["irmin-git.dev" "git+https://github.com/mirage/irmin#eio"]
  ["irmin-server.dev" "git+https://github.com/mirage/irmin#eio"]
  ["irmin-client.dev" "git+https://github.com/mirage/irmin#eio"]
  ["irmin-pack.dev" "git+https://github.com/mirage/irmin#eio"]
  ["irmin-tezos.dev" "git+https://github.com/mirage/irmin#eio"]
  ["irmin-graphql.dev" "git+https://github.com/mirage/irmin#eio"]
  ["irmin-cli.dev" "git+https://github.com/mirage/irmin#eio"]
  ["ppx_irmin.dev" "git+https://github.com/mirage/irmin#eio"]
  [ "irmin-watcher.dev" "git+https://github.com/patricoferris/irmin-watcher#d0e92b4ba5631b5f4dc0f3c00d97e79542dba45d" ]
  [ "index.dev"    "git+https://github.com/mirage/index#6e84bed48db8ab53a09926b45d899815c30f2b39"     ]

]
